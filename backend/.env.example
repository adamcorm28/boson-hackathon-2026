BOSON_API_KEY=KEY
REALTIME_MODEL=higgs-realtime
REALTIME_ENDPOINT=wss://api.boson.ai/v1/realtime
TTS_MODEL=higgs-tts-3
TTS_ENDPOINT=https://api.boson.ai/v1/audio/speech
AVATAR_MODEL=higgs-avatar
AVATAR_VIDEO_ENDPOINT=https://api.boson.ai/v1/videos
AVATAR_STREAM_ENDPOINT=https://api.boson.ai/v1/videos/stream
# Voice gateway (see docs/superpowers/plans/2026-10-23-voice-company-index.md)
ANTHROPIC_API_KEY=
COMPANY_BACKEND=mock
PAPERCLIP_URL=http://localhost:3100
INJECTION_MODE=user_message
# ARTIFACTS_DIR=/absolute/path/to/repo/artifacts   (default: <repo>/artifacts)
GATEWAY_PUBLIC_URL=http://localhost:8000
# ROLES_DIR=   (default: backend/roles, falling back to tests/gateway/fixtures/roles)
